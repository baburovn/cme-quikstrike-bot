# =================================================================
# CME Metals Terminal & Telegram Mini App Environment Configuration
# =================================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Public HTTPS URL of the WebApp / Mini App (configured in BotFather)
WEBAPP_URL=https://your-domain.com

# Server API binding
API_HOST=0.0.0.0
API_PORT=8080
UPDATE_INTERVAL_SECONDS=10

# CME Group SSO Credentials for QuikStrike Scraper
# (Alternatively configure in backend/cme_credentials.py)
CME_LOGIN=your_cme_login@example.com
CME_PASSWORD=your_cme_password
